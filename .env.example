# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL Database URL
DATABASE_URL=postgresql://bot_user:your_password@localhost:5432/wellbot

# Yandex Maps API Key (get from https://developer.tech.yandex.ru/)
YANDEX_MAPS_API_KEY=your_yandex_api_key_here
# Optional: separate key for Static Maps API (must have no IP/Referer restrictions,
# because Telegram servers download the map images, not your bot)
YANDEX_STATIC_MAPS_API_KEY=your_yandex_static_maps_api_key_here

# Optional
NODE_ENV=production
LOG_LEVEL=info

# Parse interval in seconds (default: 60 = 1 minute)
# For testing, you can set it to 10 seconds
# For production, 30-120 seconds is recommended
PARSE_INTERVAL_SECONDS=60
