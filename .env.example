# ==========================================
# Telegram Bot
# ==========================================

BOT_TOKEN=YOUR_BOT_TOKEN

# Ваш Telegram ID (для уведомлений и админ-панели)
ADMIN_ID=123456789

# ==========================================
# Subscription
# ==========================================

# Дней тестового периода для новых пользователей
TRIAL_DAYS=3

# ==========================================
# Monitoring
# ==========================================

# Интервал проверки (секунды)
CHECK_INTERVAL=30

# Задержка между поисковыми запросами к Kufar (секунды)
RATE_LIMIT_PER_SEARCH=2.5

# ==========================================
# Parser
# ==========================================

PARSER_TIMEOUT=15
PARSER_RETRY_ATTEMPTS=3
PARSER_RETRY_DELAY=2.0

# ==========================================
# PostgreSQL
# ==========================================

# Подключение к PostgreSQL (PostgresSQL connection string)
# Формат: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kufar_bot

# ==========================================
# Logs
# ==========================================

LOG_LEVEL=INFO
LOG_FILE=logs/bot.log